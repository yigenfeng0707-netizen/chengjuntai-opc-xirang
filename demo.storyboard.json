{
  "name": "成军台",
  "version": "60s-contest",
  "durationTargetSeconds": 58,
  "playwrightDir": "tools/demo-video",
  "baseUrl": "http://127.0.0.1:8090",
  "healthUrl": "http://127.0.0.1:8090/api/health",
  "outputDir": "demo-output",
  "finalMp4": "demo-output/Chengjuntai_demo_cinematic_60s.mp4",
  "viewport": { "width": 1920, "height": 1080 },
  "voice": "zh-CN-YunxiNeural",
  "voiceRate": "-6%",
  "mode": "record",
  "burnSubtitles": true,
  "subtitles": true,
  "crf": 17,
  "preset": "slow",
  "audioBitrate": "320k",
  "scenes": [
    {
      "id": "intro",
      "type": "title",
      "title": "成军台",
      "subtitle": "息壤育智 · 一人成军｜惠民 · AI+自选",
      "narration": "息壤杯作品成军台——让一个人也能成军。",
      "holdSeconds": 2,
      "minDuration": 4
    },
    {
      "id": "cta",
      "type": "browser",
      "minDuration": 9,
      "narration": "打开成军台。零讲解：只点评委六十秒体验。",
      "actions": [
        { "goto": "/" },
        { "wait": 1500 },
        { "click": { "testId": "judge-60s-cta" } },
        { "waitFor": { "text": "评委 60 秒", "timeout": 25000 } },
        { "wait": 2500 }
      ]
    },
    {
      "id": "sample",
      "type": "browser",
      "minDuration": 11,
      "narration": "样例获客战役已打开。任务树、人审与产物抽屉一屏可见，交付可验收。",
      "actions": [
        { "goto": "/" },
        { "wait": 1000 },
        { "click": { "testId": "judge-60s-cta" } },
        { "waitFor": { "text": "评委 60 秒", "timeout": 25000 } },
        { "wait": 1200 },
        { "scroll": { "y": 480 } },
        { "wait": 2800 },
        { "scroll": { "y": 260 } },
        { "wait": 2000 }
      ]
    },
    {
      "id": "word",
      "type": "browser",
      "minDuration": 11,
      "narration": "一键导出成军周报 Word——交付不是聊天记录。",
      "actions": [
        { "goto": "/" },
        { "wait": 1000 },
        { "click": { "testId": "judge-60s-cta" } },
        { "waitFor": { "text": "① 导出 Word", "timeout": 25000 } },
        { "wait": 800 },
        { "click": { "testId": "judge-export-word" } },
        { "wait": 5500 }
      ]
    },
    {
      "id": "nl2sql",
      "type": "browser",
      "minDuration": 10,
      "narration": "再看数据参谋一张表。真政采标讯可问数佐证。",
      "actions": [
        { "goto": "/" },
        { "wait": 1000 },
        { "click": { "testId": "judge-60s-cta" } },
        { "waitFor": { "text": "② 智能问数一表", "timeout": 25000 } },
        { "wait": 800 },
        { "click": { "testId": "judge-nl2sql" } },
        { "wait": 5000 },
        { "scroll": { "y": 220 } },
        { "wait": 2000 }
      ]
    },
    {
      "id": "outro",
      "type": "title",
      "title": "息壤育智 · 一人成军",
      "subtitle": "成军台 · 惠民产品创新 · AI+自选开放场景",
      "narration": "成军台，息壤育智，一人成军。谢谢评委。",
      "holdSeconds": 2,
      "minDuration": 6
    }
  ]
}
