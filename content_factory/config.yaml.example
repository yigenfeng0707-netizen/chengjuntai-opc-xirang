# ========== 内容工厂统一配置文件（模板）==========
# 复制本文件为 config.yaml，填入真实密钥后使用
# cp config.yaml.example config.yaml

# ---------- 基础路径 ----------
project_root: "./content_factory"
bid_pipeline_root: ""
knowledge_sync_folder: "${bid_pipeline_root}/knowledge/library"
vector_sync_path: "${bid_pipeline_root}/vector_db"

# ---------- NL2SQL 智能问数联动 ----------
nl2sql_mcp_url: "http://127.0.0.1:8765/mcp"
nl2sql_default_dataset: "bid_projects"
nl2sql_default_user_id: ""

nl2sql_backend:
  znws_query_url: "http://127.0.0.1:8082/api/v1"
  api_token: "CHANGE_ME_TO_RANDOM_TOKEN"      # 部署时用 `openssl rand -hex 16` 生成
  mcp_host: "127.0.0.1"
  mcp_port: 8765
  cache_ttl: 300

# ---------- 通用 ----------
auto_path_fix: true
network_timeout: 15
max_retry: 3
retry_interval: 10

# ---------- 邮件告警 ----------
smtp_server: ""
smtp_port: 465
smtp_user: ""
smtp_password: ""
mail_receivers: []

# ---------- Web 面板 ----------
web_host: "127.0.0.1"
web_port: 8090
web_username: "admin"
web_password: "CHANGE_ME_AFTER_DEPLOY"

# ---------- 日志 ----------
log_roll_days: 30

# ---------- LLM 配置 ----------
llm:
  enabled: true
  temperature: 0.7
  max_tokens: 8192
  enable_thinking: true       # 推理模型开启思考过程，提升 SQL 质量
  providers:
    - name: "primary-商汤SenseNova"
      api_base: "https://token.sensenova.cn/v1"
      api_key: "YOUR_SENSENOVA_API_KEY"       # ← 填入你的商汤 API Key
      model: "sensenova-6.7-flash-lite"
      enabled: true
      timeout: 60
    - name: "fallback-阿里云百炼"
      api_base: "https://dashscope.aliyuncs.com/compatible-mode/v1"
      api_key: "YOUR_ALIYUN_API_KEY"          # ← 填入你的阿里云 DashScope Key
      model: "qwen3.7-max"
      enabled: true
      timeout: 90

# ---------- RSS 资讯源 ----------
rss_sources: []

# ---------- 内容生成参数 ----------
article:
  target_min_words: 800
  target_max_words: 4000
  require_code_block: true

# ---------- 端口冲突规避 ----------
reserved_ports: [8082, 8765]
